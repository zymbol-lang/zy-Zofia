// @vm-skip
// Test: forward pass de red neuronal de 2 capas
// Arquitectura: entrada(2) -> oculta(3) -> salida(1)
// Activacion oculta: tanh | Activacion salida: sigmoid

<# std/math => mat

// Proyecta vector x a través de capa (W: matriz, b: sesgo)
// W tiene forma [m x n]: m neuronas, n entradas
proyectar(x, W, b) {
    n = x$#
    m = W$#
    salida = []
    @ j:1..m {
        suma = b[j]
        @ i:1..n { suma = suma + x[i] * W[j>i] }
        salida = salida$+ suma
    }
    <~ salida
}

// Pesos capa 1: 3 neuronas x 2 entradas
W1 = [[0.5, -0.3], [0.1, 0.8], [-0.2, 0.4]]
b1 = [0.0, 0.0, 0.0]

// Pesos capa 2: 1 neurona x 3 entradas
W2 = [[0.6, -0.4, 0.9]]
b2 = [0.0]

// Entrada
x = [1.0, 0.5]

// Forward pass — activaciones sin HOF para evitar bug de alias de módulo
z1 = proyectar(x, W1, b1)
a1 = z1 $> v -> mat::tanh(v)

z2 = proyectar(a1, W2, b2)
a2 = z2 $> v -> mat::sigmoid(v)

>> #.4|a1[1]| ¶
>> #.4|a1[2]| ¶
>> #.4|a1[3]| ¶
>> #.4|a2[1]| ¶
