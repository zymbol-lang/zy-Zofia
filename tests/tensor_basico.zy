// Test: crear tensores, acceso profundo, y actualización con $~

ceros(n) {
    fila = []
    @ _i:1..n { fila = fila$+ 0.0 }
    <~ fila
}

matriz_ceros(filas, cols) {
    mat = []
    @ _i:1..filas { mat = mat$+ ceros(cols) }
    <~ mat
}

m = matriz_ceros(2, 3)
>> (m$#) ¶
>> (m[1]$#) ¶
>> m[1] ¶
>> m[2] ¶

// Actualización profunda con $~ — sintaxis canónica Zymbol
m = m[1>2]$~ 5.0
>> m ¶
>> m[1>2] ¶
