# grad {
    #> {
        variable
        gradiente_de
        asignar_grad
        reiniciar_grad
        paso_gradiente
        reiniciar_gradientes
        paso_gradiente_lista
        mse
        gradiente_mse
        imprimir_var
    }

    variable(valor, nombre) {
        // Crea una variable escalar con acumulador de gradiente inicializado a 0
        // Fuente: Baydin et al. (2018), Automatic Differentiation in Machine Learning
        <~ #(valor: valor, grad: 0.0, nombre: nombre)
    }

    gradiente_de(v) {
        // Devuelve el gradiente acumulado actual de la variable
        <~ v.grad
    }

    asignar_grad(v, g) {
        // Devuelve la variable con el gradiente establecido a g
        <~ v["grad"]$~ g
    }

    reiniciar_grad(v) {
        // Pone el gradiente a cero antes del siguiente pase hacia adelante
        <~ v["grad"]$~ 0.0
    }

    paso_gradiente(v, tasa) {
        // Paso SGD: w ← w − α × ∂L/∂w, luego pone gradiente a cero
        // Fuente: Ruder (2016), An Overview of Gradient Descent Optimization Algorithms
        nuevo = v.valor - tasa * v.grad
        v2 = v["valor"]$~ nuevo
        <~ v2["grad"]$~ 0.0
    }

    reiniciar_gradientes(vars) {
        // Pone a cero los gradientes de toda una lista de variables
        res = []
        @ v:vars { res = res$+ reiniciar_grad(v) }
        <~ res
    }

    paso_gradiente_lista(vars, tasa) {
        // Aplica un paso SGD a cada variable de la lista
        res = []
        @ v:vars { res = res$+ paso_gradiente(v, tasa) }
        <~ res
    }

    mse(y_pred, y_real) {
        // Error cuadrático medio: (1/n) × Σ(ŷᵢ − yᵢ)²
        // Fuente: función de pérdida estándar para regresión, siempre no negativa
        n = y_pred$#
        suma = 0.0
        @ i:1..n {
            diff = y_pred[i] - y_real[i]
            suma = suma + diff * diff
        }
        <~ suma / ##.(n)
    }

    gradiente_mse(y_pred, y_real) {
        // Gradiente del ECM respecto a las predicciones: (2/n) × (ŷᵢ − yᵢ)
        // Fuente: ∂ECM/∂ŷᵢ = (2/n)(ŷᵢ − yᵢ)
        n = y_pred$#
        factor = 2.0 / ##.(n)
        g = []
        @ i:1..n {
            g = g$+ (factor * (y_pred[i] - y_real[i]))
        }
        <~ g
    }

    imprimir_var(v) {
        >> v.nombre >> ": " >> v.valor >> " (grad: " >> v.grad >> ")" ¶
    }
}
