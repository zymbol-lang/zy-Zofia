# atencion {
    <# std/math   => _mat
    <# tensor     => _ten
    <# activacion => _act

    #> {
        proyectar
        atencion_producto_punto
        atencion_enmascarada
        atencion_multiencabezado
    }

    // Aplica softmax fila a fila sobre una matriz
    _softmax_filas(M) {
        res = []
        @ fila:M { res = res$+ _act::softmax(fila) }
        <~ res
    }

    // Extrae columnas [inicio..fin] (base 1, inclusive) de cada fila
    _extraer_cols(M, inicio, fin) {
        res = []
        @ fila:M {
            cols = []
            @ j:inicio..fin { cols = cols$+ fila[j] }
            res = res$+ cols
        }
        <~ res
    }

    // Concatena las columnas de B a la derecha de las columnas de A, fila a fila
    _concat_cols(A, B) {
        res = []
        @ i:1..(A$#) {
            fila = []
            @ j:1..(A[i]$#) { fila = fila$+ A[i>j] }
            @ j:1..(B[i]$#) { fila = fila$+ B[i>j] }
            res = res$+ fila
        }
        <~ res
    }

    proyectar(entrada, pesos, sesgo) {
        // Proyección lineal: entrada × pesos + sesgo (sesgo difundido sobre las filas)
        // Fuente: transformación afín estándar en redes neuronales
        base = _ten::producto_matricial(entrada, pesos)
        res = []
        @ fila:base { res = res$+ _ten::sumar(fila, sesgo) }
        <~ res
    }

    atencion_producto_punto(Q, K, V) {
        // Atención(Q,K,V) = softmax(Q·Kᵀ / √dₖ) · V
        // Fuente: Vaswani et al. (2017), "Attention Is All You Need", Ecuación 1
        dk     = K[1]$#
        escala = 1.0 / _mat::sqrt(##.(dk))
        Kt     = _ten::transponer(K)
        puntos = _ten::multiplicar_escalar(_ten::producto_matricial(Q, Kt), escala)
        pesos  = _softmax_filas(puntos)
        <~ _ten::producto_matricial(pesos, V)
    }

    atencion_enmascarada(Q, K, V, mascara) {
        // Atención con máscara: asigna −1e9 donde mascara==falso antes del softmax
        // Fuente: Vaswani et al. (2017); usada en el decodificador para bloquear posiciones futuras
        dk     = K[1]$#
        escala = 1.0 / _mat::sqrt(##.(dk))
        Kt     = _ten::transponer(K)
        puntos = _ten::multiplicar_escalar(_ten::producto_matricial(Q, Kt), escala)
        puntos_m = []
        @ i:1..(puntos$#) {
            fila = []
            @ j:1..(puntos[i]$#) {
                ? (mascara[i>j]) {
                    fila = fila$+ puntos[i>j]
                } _ {
                    fila = fila$+ (-1000000000.0)
                }
            }
            puntos_m = puntos_m$+ fila
        }
        pesos = _softmax_filas(puntos_m)
        <~ _ten::producto_matricial(pesos, V)
    }

    atencion_multiencabezado(Q, K, V, config) {
        // MultiCabeza(Q,K,V) = Concat(cabeza₁,…,cabezaₕ) × W_O
        // Fuente: Vaswani et al. (2017), Sección 3.2.2
        // config: (num_cabezas, dim_modelo, pesos_q, pesos_k, pesos_v, pesos_o)
        nh      = config.num_cabezas
        dm      = config.dim_modelo
        dim_cab = dm / nh

        // Proyectar entradas a la dimensión completa del modelo (sin sesgo en proyecciones QKV)
        Q_full = _ten::producto_matricial(Q, config.pesos_q)
        K_full = _ten::producto_matricial(K, config.pesos_k)
        V_full = _ten::producto_matricial(V, config.pesos_v)

        // Atención por cabeza con segmentación de columnas y concatenación
        concat  = []
        primera = #1
        @ h:1..nh {
            inicio  = (h - 1) * dim_cab + 1
            fin     = h * dim_cab
            Qh      = _extraer_cols(Q_full, inicio, fin)
            Kh      = _extraer_cols(K_full, inicio, fin)
            Vh      = _extraer_cols(V_full, inicio, fin)
            cabeza  = atencion_producto_punto(Qh, Kh, Vh)
            ? (primera) {
                concat  = cabeza
                primera = #0
            } _ {
                concat = _concat_cols(concat, cabeza)
            }
        }

        // Proyección de salida W_O: [dim_modelo × dim_modelo]
        <~ _ten::producto_matricial(concat, config.pesos_o)
    }
}
