# perdida {
    <# std/math => _mat

    #> {
        mse
        bce_escalar
        entropia_cruzada_binaria
        entropia_cruzada
    }

    _ln_seguro(x) {
        // Logaritmo numéricamente estable: recorta en ε = 1e-7 para evitar log(0) = −∞
        ? (x < 0.0000001) { <~ _mat::ln(0.0000001) }
        <~ _mat::ln(x)
    }

    mse(y_pred, y_real) {
        // Error cuadrático medio: (1/n) × Σ(ŷᵢ − yᵢ)²
        // Fuente: función de pérdida estándar para regresión, siempre no negativa
        n = y_pred$#
        suma = 0.0
        @ i:1..n {
            diff = y_pred[i] - y_real[i]
            suma = suma + diff * diff
        }
        <~ suma / ##.(n)
    }

    bce_escalar(yhat, y) {
        // Entropía cruzada binaria para un único par (predicción, objetivo)
        // L = −[y·log(ŷ) + (1−y)·log(1−ŷ)]
        // Fuente: función de pérdida estándar para clasificación binaria
        <~ -(y * _ln_seguro(yhat) + (1.0 - y) * _ln_seguro(1.0 - yhat))
    }

    entropia_cruzada_binaria(y_hat, y) {
        // BCE promediada sobre un vector: (1/n) × Σᵢ BCE(ŷᵢ, yᵢ)
        n = y_hat$#
        suma = 0.0
        @ i:1..n { suma = suma + bce_escalar(y_hat[i], y[i]) }
        <~ suma / ##.(n)
    }

    entropia_cruzada(y_hat, y) {
        // Entropía cruzada multiclase: −Σᵢ yᵢ·log(ŷᵢ)
        // Fuente: función de pérdida estándar para clasificación multiclase; se usa con softmax
        suma = 0.0
        @ i:1..(y_hat$#) { suma = suma + y[i] * _ln_seguro(y_hat[i]) }
        <~ -suma
    }
}
