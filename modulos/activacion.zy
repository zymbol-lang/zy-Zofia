# activacion {
    <# std/math => _mat

    #> {
        relu
        relu_gradiente
        relu_vec
        relu_grad_vec
        sigmoide
        sigmoide_vec
        tangente_hiperbolica
        tangente_hiperbolica_vec
        tanh_grad_vec
        softmax
    }

    relu(x) {
        // ReLU: max(0, x) — introduce no linealidad sin saturación en positivos
        // Fuente: Nair & Hinton (2010), Rectified Linear Units Improve RBMs
        ? (x > 0.0) { <~ x }
        <~ 0.0
    }

    relu_gradiente(x) {
        // ∂ReLU/∂x: 1 si x > 0, 0 en caso contrario (indefinido en 0, devolvemos 0)
        ? (x > 0.0) { <~ 1.0 }
        <~ 0.0
    }

    relu_vec(v) {
        // Aplica relu elemento a elemento sobre un vector
        res = []
        @ x:v { res = res$+ relu(x) }
        <~ res
    }

    relu_grad_vec(v) {
        // Aplica relu_gradiente elemento a elemento sobre el vector de preactivaciones
        res = []
        @ x:v { res = res$+ relu_gradiente(x) }
        <~ res
    }

    sigmoide(x) {
        // σ(x) = 1 / (1 + e^−x) — mapea cualquier real a (0, 1)
        // Fuente: Rosenblatt (1958); usada como activación de salida binaria
        <~ _mat::sigmoid(x)
    }

    sigmoide_vec(v) {
        // Aplica sigmoide elemento a elemento sobre un vector
        res = []
        @ x:v { res = res$+ _mat::sigmoid(x) }
        <~ res
    }

    tangente_hiperbolica(x) {
        // tanh(x) — mapea cualquier real a (−1, 1); centrada en cero a diferencia de sigmoide
        <~ _mat::tanh(x)
    }

    tangente_hiperbolica_vec(v) {
        // Aplica tanh elemento a elemento sobre un vector
        res = []
        @ x:v { res = res$+ _mat::tanh(x) }
        <~ res
    }

    tanh_grad_vec(a_vec) {
        // ∂tanh/∂z usando la salida cacheada a: 1 − a²
        // Se pasa el vector de salidas ya calculadas para evitar recomputar en retropropagación
        // Fuente: identidad estándar de la derivada de tanh
        res = []
        @ a:a_vec { res = res$+ (1.0 - a * a) }
        <~ res
    }

    softmax(v) {
        // softmax(v)ᵢ = e^vᵢ / Σⱼ e^vⱼ — convierte puntuaciones en probabilidades que suman 1
        // Fuente: Bridle (1990); usada en clasificación multiclase y mecanismos de atención
        exps = []
        @ x:v { exps = exps$+ _mat::exp(x) }
        suma = 0.0
        @ e:exps { suma = suma + e }
        res = []
        @ e:exps { res = res$+ (e / suma) }
        <~ res
    }
}
